PDFAIRY_HOST=127.0.0.1
PDFAIRY_PORT=8080
PDFAIRY_ENV=development
# Required for staging/production; use the real externally reachable HTTPS origin.
PDFAIRY_PUBLIC_URL=
# Optional extra origins. PDFAIRY_PUBLIC_URL is automatically allowed.
PDFAIRY_ALLOWED_ORIGINS=
# Exact reverse-proxy peer IPs only; never use a wildcard.
PDFAIRY_TRUSTED_PROXIES=
# Set to render only on a Render web service; leave blank elsewhere.
PDFAIRY_PROXY_MODE=
PDFAIRY_MAX_FILE_MB=50
PDFAIRY_MAX_BODY_MB=80
PDFAIRY_MAX_OUTPUT_MB=100
PDFAIRY_MAX_FILES=20
PDFAIRY_MAX_PAGES=100
PDFAIRY_MAX_CONCURRENT=2
PDFAIRY_REQUEST_TIMEOUT=120
PDFAIRY_OFFICE_TIMEOUT=90
PDFAIRY_ENABLE_OFFICE=false
PDFAIRY_LIBREOFFICE_PATH=
PDFAIRY_TEMP_DIR=
PDFAIRY_LOG_REQUESTS=false
